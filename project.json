{
  "name": "mosaic-board",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "includedScripts": [],
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "./src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/mosaic-board"],
      "options": {
        "cwd": "{workspaceRoot}",
        "commands": [
          "node scripts/sync-extension-version.mjs",
          "nx run mosaic-board:build-angular:production",
          "node scripts/write-extension-manifest-to-dist.mjs"
        ],
        "parallel": false
      },
      "configurations": {
        "production": {
          "commands": [
            "node scripts/sync-extension-version.mjs",
            "nx run mosaic-board:build-angular:production",
            "node scripts/write-extension-manifest-to-dist.mjs"
          ]
        },
        "development": {
          "commands": [
            "node scripts/sync-extension-version.mjs",
            "nx run mosaic-board:build-angular:development",
            "node scripts/write-extension-manifest-to-dist.mjs"
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "build-angular": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/mosaic-board",
        "browser": "./src/main.ts",
        "tsConfig": "tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "public"
          }
        ],
        "styles": ["./src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "mosaic-board:build-angular:production"
        },
        "development": {
          "buildTarget": "mosaic-board:build-angular:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["./src"]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {}
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "mosaic-board:build-angular",
        "port": 4200,
        "staticFilePath": "dist/mosaic-board/browser",
        "spa": true
      }
    }
  }
}
