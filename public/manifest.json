{
    "manifest_version": 3,
    "name": "Mosaic Board",
    "version": "1.5.0",
    "description": "Build your personal New Tab dashboard with draggable and resizable widgets. Your web, organized.",
    "permissions": [
        "bookmarks",
        "storage"
    ],
    "host_permissions": [
        "https://*/*",
        "http://*/*"
    ],
    "chrome_url_overrides": {
        "newtab": "new-tab.html"
    },
    "icons": {
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' https://www.google.com/s2/favicons?sz=64&domain_url=* data:;"
    },
    "action": {
        "default_title": "Mosaic Board",
        "default_icon": {
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "offline_enabled": true
}
