{
  "manifest_version": 3,
  "name": "Mosaic Board",
  "version": "0.0.2",
  "description": "Build your personal dashboard with draggable and resizable widgets. Your web, organized.",
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "bookmarks"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"
  }
}
